{
  "kind": "collectionType",
  "collectionName": "library_agents",
  "info": {
    "singularName": "library-agent",
    "pluralName": "library-agents",
    "displayName": "LibraryAgent",
    "name": "LibraryAgent",
    "description": "A2A agents published in the developer portal"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "description": {
      "type": "text"
    },
    "version": {
      "type": "string"
    },
    "a2aVersion": {
      "type": "enumeration",
      "enum": [
        "v0_3",
        "v1_0"
      ]
    },
    "protocols": {
      "type": "component",
      "component": "agents.protocol",
      "repeatable": true
    },
    "markdown": {
      "type": "richtext"
    },
    "image": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ]
    },
    "agentCard": {
      "type": "json",
      "required": true
    },
    "reportUrl": {
      "type": "string"
    },
    "ratings": {
      "type": "component",
      "component": "apis.ratings",
      "repeatable": false
    }
  }
}
