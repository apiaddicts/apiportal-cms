{
  "kind": "collectionType",
  "collectionName": "library_apis",
  "info": {
    "singularName": "library-api",
    "pluralName": "library-apis",
    "displayName": "LibraryApi",
    "name": "LibraryApi",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid"
    },
    "description": {
      "type": "text"
    },
    "color_status": {
      "type": "string"
    },
    "provider": {
      "type": "enumeration",
      "enum": [
        "mulesoft",
        "kong",
        "aws"
      ]
    },
    "image": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ]
    },
    "version": {
      "type": "string"
    },
    "buttons": {
      "type": "component",
      "component": "links.button",
      "repeatable": true
    },
    "tags": {
      "type": "component",
      "component": "elements.titles",
      "repeatable": true
    },
    "openDocType": {
      "type": "enumeration",
      "required": true,
      "default": "api",
      "enum": [
        "api",
        "asyncapi"
      ]
    },
    "openDocFormat": {
      "type": "enumeration",
      "required": true,
      "default": "json",
      "enum": [
        "json",
        "yaml"
      ]
    },
    "openDocUrl": {
      "type": "string",
      "regex": "^(https?:\\/\\/).+"
    },
    "openDoc": {
      "type": "customField",
      "customField": "plugin::strapi-code-editor-custom-field.code-editor-text",
      "options": {
        "language": "plaintext"
      }
    },
    "markdown": {
      "type": "richtext"
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "mappedBy": "library_apis"
    },
    "ratings": {
      "type": "component",
      "component": "apis.ratings",
      "repeatable": false
    },
    "aiReady": {
      "type": "boolean",
      "default": false
    },
    "devExperienceCheck": {
      "type": "boolean",
      "default": false
    },
    "securityCheck": {
      "type": "boolean",
      "default": false
    },
    "qualityCheck": {
      "type": "boolean",
      "default": false
    },
    "doraCheck": {
      "type": "boolean",
      "default": false
    },
    "openFinanceCheck": {
      "type": "boolean",
      "default": false
    },
    "publish": {
      "type": "enumeration",
      "enum": [
        "publicado",
        "noPublicado"
      ]
    },
    "externalServiceId": {
      "type": "string"
    },
    "apim_config": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::apim-config.apim-config",
      "inversedBy": "library_apis"
    }
  }
}
