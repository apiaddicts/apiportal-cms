{
  "kind": "collectionType",
  "collectionName": "library_catalogs",
  "info": {
    "singularName": "library-catalog",
    "pluralName": "library-catalogs",
    "displayName": "LibraryCatalog",
    "name": "LibraryCatalog",
    "description": ""
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid"
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "allowedTypes": ["images", "files", "videos"],
      "multiple": true,
      "required": false
    },
    "version": {
      "type": "string"
    },
    "buttons": {
      "type": "component",
      "repeatable": true,
      "component": "links.button"
    },
    "tags": {
      "type": "component",
      "repeatable": true,
      "component": "elements.titles"
    },
    "dataSource": {
      "type": "customField",
      "customField": "plugin::strapi-code-editor-custom-field.code-editor-text",
      "options": {
        "language": "plaintext"
      }
    },
    "markdown": {
      "type": "richtext"
    },
    "aiReady": {
      "type": "boolean",
      "default": false
    },
    "publish": {
      "type": "enumeration",
      "enum": [
        "publicado",
        "noPublicado"
      ]
    }
  }
}
