{
  "kind": "collectionType",
  "collectionName": "apim_configs",
  "info": {
    "singularName": "apim-config",
    "pluralName": "apim-configs",
    "displayName": "ApimConfig",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "user_credentials": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::user-credential.user-credential",
      "mappedBy": "apim_config"
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "apim_config"
    },
    "library_apis": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::library-api.library-api",
      "mappedBy": "apim_config"
    },
    "configurations": {
      "type": "dynamiczone",
      "components": [
        "config.mulesoft",
        "config.kong",
        "config.aws"
      ],
      "required": true,
      "max": 1
    }
  }
}
