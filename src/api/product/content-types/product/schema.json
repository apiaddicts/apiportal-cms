{
  "kind": "collectionType",
  "collectionName": "product",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Products",
    "name": "Products",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "price": {
      "type": "integer"
    },
    "description": {
      "type": "text"
    },
    "isActive": {
      "type": "boolean",
      "default": false
    },
    "requiredSubscription": {
      "type": "boolean",
      "default": false
    },
    "requiredApproval": {
      "type": "boolean",
      "default": false
    },
    "limitSubscription": {
      "type": "integer"
    },
    "legalConditionals": {
      "type": "richtext"
    },
    "library_apis": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::library-api.library-api",
      "inversedBy": "products"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "products"
    },
    "user_credentials": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::user-credential.user-credential",
      "inversedBy": "products"
    },
    "apim_config": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::apim-config.apim-config",
      "inversedBy": "products"
    }
  }
}
