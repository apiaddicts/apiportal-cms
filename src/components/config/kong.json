{
  "collectionName": "components_config_kong",
  "info": {
    "name": "kong",
    "displayName": "Kong Config",
    "icon": "code",
    "description": "Configuración específica para Kong"
  },
  "options": {},
  "attributes": {
    "adminUrl": {
      "type": "string",
      "required": true
    },
    "authType": {
      "type": "enumeration",
      "required": true,
      "default": "oauth",
      "enum": [
        "oauth",
        "apikey"
      ]
    },
    "apiKey": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "authType"
            },
            "apikey"
          ]
        }
      },
      "required": false
    },
    "tokenUrl": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "authType"
            },
            "oauth"
          ]
        }
      }
    },
    "clientId": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "authType"
            },
            "oauth"
          ]
        }
      }
    },
    "clientSecret": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "authType"
            },
            "oauth"
          ]
        }
      }
    },
    "scope": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "authType"
            },
            "oauth"
          ]
        }
      }
    },
    "tokenHeaderName": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "authType"
            },
            "oauth"
          ]
        }
      },
      "default": "authorization-token"
    }
  }
}
